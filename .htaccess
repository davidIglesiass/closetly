<IfModule mod_rewrite.c>
    RewriteEngine on
    ErrorDocument 404 /error/

    RewriteCond %{SCRIPT_FILENAME} !-d
    RewriteCond %{SCRIPT_FILENAME} !-f
    RewriteRule ^(.*)/(.*) index.php?controller=$1&action=$2
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js
</IfModule>